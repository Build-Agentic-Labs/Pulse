<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="ContentApp">
  <Id>7c80e6f4-3d8d-49f2-bb65-684edc61f4a9</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Pulse</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="M-Tools Gantt" />
  <Description DefaultValue="Runs the M-Tools manufacturing Gantt workspace inside Excel." />
  <IconUrl DefaultValue="https://localhost:3000/excel-gantt-icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/excel-gantt-icon-128.png" />
  <SupportUrl DefaultValue="https://localhost:3000/" />
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/excel/gantt" />
    <RequestedWidth>1000</RequestedWidth>
    <RequestedHeight>800</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
